# DevSprint local configuration
# Copy this file to .env for local development.
# Do not commit .env or any private credentials.

# Supabase project configuration.
# SUPABASE_ANON_KEY / publishable key is safe to ship in a client app,
# but your Supabase project MUST enforce Row Level Security (RLS).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Gemini is intentionally NOT configured here.
# Enter the Gemini API key inside DevSprint Settings. It is stored in
# platform secure storage and is not included in source control.
